{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tacitus:capsule:v1",
  "title": "Provisional Tacitus capsule v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "required": [
    "manifest",
    "data"
  ],
  "$defs": {
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer"
        },
        "end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "text_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "original_language": {
          "type": "string"
        },
        "translation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "text_hash",
        "start",
        "end",
        "locator",
        "original_language",
        "translation"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "workspace": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "original_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "text_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "text": {
          "const": ""
        },
        "language": {
          "type": "string"
        },
        "extraction_tool": {
          "type": "string"
        },
        "published_at": {
          "type": "integer"
        },
        "retrieved_at": {
          "type": "integer"
        },
        "available": {
          "$ref": "#/$defs/interval"
        },
        "valid": {
          "$ref": "#/$defs/interval"
        },
        "source_family": {
          "type": "string"
        },
        "withdrawn": {
          "const": false
        },
        "restricted": {
          "const": false
        },
        "redistributable": {
          "type": "boolean"
        },
        "license": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "workspace",
        "title",
        "author",
        "original_hash",
        "text_hash",
        "text",
        "language",
        "extraction_tool",
        "published_at",
        "retrieved_at",
        "available",
        "valid",
        "source_family",
        "withdrawn",
        "restricted",
        "redistributable",
        "license"
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "workspace": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "speaker": {
          "type": "string"
        },
        "proposition": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "object": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "epistemic_type": {
          "enum": [
            "reported_statement",
            "observation",
            "allegation",
            "inference",
            "hypothesis",
            "forecast",
            "value_judgment",
            "recommendation"
          ]
        },
        "polarity": {
          "type": "string"
        },
        "modality": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audience": {
          "type": "string"
        },
        "speech_act": {
          "type": "string"
        },
        "valid": {
          "$ref": "#/$defs/interval"
        },
        "available": {
          "$ref": "#/$defs/interval"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "challenges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "string"
        },
        "confidence_rationale": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "workspace",
        "profile",
        "speaker",
        "proposition",
        "subject",
        "object",
        "epistemic_type",
        "polarity",
        "modality",
        "conditions",
        "exceptions",
        "audience",
        "speech_act",
        "valid",
        "available",
        "evidence",
        "dependencies",
        "challenges",
        "supersedes",
        "confidence",
        "confidence_rationale"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "type": "string"
        },
        "assertion_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "reviewer": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "integer"
        },
        "decision": {
          "enum": [
            "accept",
            "reject",
            "caveat"
          ]
        },
        "origin": {
          "enum": [
            "local_human",
            "imported_attestation",
            "model_suggestion",
            "synthetic_test"
          ]
        }
      },
      "required": [
        "assertion_id",
        "assertion_fingerprint",
        "evidence_hashes",
        "reviewer",
        "rationale",
        "reviewed_at",
        "decision",
        "origin"
      ]
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "distinction",
            "cue",
            "heuristic",
            "pattern",
            "exception",
            "red_flag",
            "language_rule",
            "procedure",
            "case",
            "unknown",
            "revision_trigger"
          ]
        },
        "description": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "failure_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_state": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "kind",
        "description",
        "scope",
        "failure_conditions",
        "provenance",
        "review_state"
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "package_version": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "profile": {
          "enum": [
            "context",
            "cognitive_method",
            "output_artifact"
          ]
        },
        "created_at": {
          "type": "integer"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          },
          "maxItems": 16
        },
        "license": {
          "type": "string"
        },
        "confidentiality": {
          "enum": [
            "public",
            "private",
            "restricted"
          ]
        },
        "sharing_policy": {
          "type": "string"
        },
        "evidence_mode": {
          "enum": [
            "references_only",
            "evidence_included"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "schema_version",
        "package_version",
        "id",
        "author",
        "title",
        "domain",
        "scope",
        "purpose",
        "profile",
        "created_at",
        "valid_until",
        "supersedes",
        "dependencies",
        "license",
        "confidentiality",
        "sharing_policy",
        "evidence_mode",
        "limitations",
        "files"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          },
          "maxItems": 256
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "maxItems": 32
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/method"
          },
          "maxItems": 32
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review"
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "assertions",
        "sources",
        "methods",
        "reviews",
        "artifacts"
      ]
    }
  }
}
