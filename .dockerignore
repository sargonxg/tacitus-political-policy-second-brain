# Ignore everything except what we need
**/.env
**/.env.*
**/*.env
runtime/
uploads/
exports/
backups/
.tacitus/
**/*.dump
**/*.pem
# WHY: Build context is now repo root so edgequake-pdf2md path dep is accessible.
# We explicitly include edgequake/ and edgequake-pdf2md/ and exclude everything else.
**/.git
**/.github
**/.vscode
**/.claude
**/.pytest_cache
**/.playwright-mcp
**/target
**/node_modules
**/__pycache__
**/logs
**/test-results
**/archive
**/docs
**/docs_retro
**/audit_*
**/lightrag
**/lightrag_webui
**/open-webui
**/plan_*
**/sessions
**/specs
**/tech_stack
**/ux_ui_map
**/zz_test_docs
**/zz-explore
**/articles
**/*.log
**/*.md
!**/README.md
# Exclude everything except edgequake/ and edgequake-pdf2md/ subdirs
edgequake-website/
# Do NOT blanket-exclude edgequake_webui/ — OpenAPI schema + Next configs must
# be in the frontend image build context (parent exclude blocks !re-includes).
# Artifact excludes below keep context lean.
sdks/
tools/
tests/
examples/
mission/
qa/
wiki/
**/*.py
**/*.sh
!**/scripts/*.sh

# Allow necessary JSON files
!**/package.json
!**/tsconfig.json
!**/next.config.ts
!**/components.json

# Explicitly exclude frontend build artifacts
edgequake_webui/node_modules
edgequake_webui/.next
edgequake_webui/out
edgequake_webui/dist
edgequake_webui/build
edgequake_webui/coverage
edgequake_webui/test-results
edgequake_webui/playwright-report
edgequake_webui/.playwright
edgequake_webui/*.pid
edgequake_webui/*.txt
edgequake_webui/e2e
!edgequake_webui/package.json
!edgequake_webui/pnpm-lock.yaml
!edgequake_webui/postcss.config.mjs
!edgequake_webui/eslint.config.mjs
!edgequake_webui/vitest.config.mjs
!edgequake_webui/src/
!edgequake_webui/public/
!edgequake_webui/openapi/


